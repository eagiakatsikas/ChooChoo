# Your Network Rail Open Data login (email + password)
NR_USERNAME=you@example.com
NR_PASSWORD=your-password
# Unique name for this running instance (letters, numbers, dashes)
NR_CLIENT_ID=london-trains-1
# Your Vercel site URL, so only it can read the stream (or * for any)
ALLOWED_ORIGIN=https://your-site.vercel.app
# Optional: area that counts as "London" (south,west,north,east)
# LONDON_BBOX=51.28,-0.52,51.70,0.34
